# GhostShell-Cloud — environment variables
# Railway sets DATABASE_URL automatically when you attach a Postgres service.
# Copy this file to `.env` for local dev only; Railway uses its own dashboard.

# ── Required ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/ghostshell_cloud

# ── Zero-knowledge peppers (REQUIRED in production) ─────────────────────
# Each is a base64-encoded 32-byte secret.  Generate fresh values with:
#   python -m security
# All four MUST be set in Railway.  Leave unset locally and security.py
# falls back to deterministic INSECURE values (logged loudly at boot).
FINGERPRINT_PEPPER=
EMAIL_PEPPER=
LICENSE_KEY_PEPPER=
IP_PEPPER=

# ── Trial / license behaviour ───────────────────────────────────────────
TRIAL_DURATION_DAYS=7
LICENSE_MAX_DEVICES=5

# ── Stripe (Phase B.3 — leave empty until checkout is wired) ────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_TAX_ENABLED=true

# ── VPN / VM detection (Phase B.3) ──────────────────────────────────────
# Provider for IP intelligence.  "ipqs" or "proxycheck" supported; empty
# disables the check (every IP passes — fine for dev).
VPN_CHECK_PROVIDER=
VPN_CHECK_API_KEY=

# ── Server tuning ───────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=120
DEVICE_TTL_DAYS=180
