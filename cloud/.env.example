# Vispora-Cloud — environment variables.
# Copy to `.env` for local development only.  On Railway, set these under the
# service's Variables tab; the Dockerfile and settings.py read the same names.

# ── Required ─────────────────────────────────────────────────────────────
# Railway: reference the Postgres plugin → ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://vispora:vispora@127.0.0.1:5432/vispora

# ── Zero-knowledge peppers (REQUIRED in production — boot refuses without them)
# Four independent base64-encoded 32-byte secrets.  Generate with:
#   make peppers        (or: python -m security)
# Locally they may stay empty: security.py falls back to deterministic
# INSECURE values and logs a warning on every boot.
FINGERPRINT_PEPPER=
EMAIL_PEPPER=
LICENSE_KEY_PEPPER=
IP_PEPPER=

# ── Deployment ───────────────────────────────────────────────────────────
# "production" switches on the strict defaults below.  Unset, it is taken from
# Railway's RAILWAY_ENVIRONMENT_NAME, so a Railway environment called
# "production" is production without any extra configuration.
APP_ENV=development
LOG_LEVEL=info
# json | text.  Default: json on Railway / in production, text elsewhere.
LOG_FORMAT=
# Swagger UI at /docs.  Default: on outside production, off in production.
EXPOSE_DOCS=
# uvicorn worker processes.  Default 1.  The in-memory rate limiter is per
# worker, so N workers means N× the per-client budget.
WEB_CONCURRENCY=1

# ── HTTP hardening ───────────────────────────────────────────────────────
# Reverse-proxy hops in front of the app that append X-Forwarded-For.
# Default: 1 on Railway / in production (Railway's edge), 0 elsewhere.
TRUSTED_PROXY_HOPS=
# Largest accepted request body, in bytes.
MAX_BODY_BYTES=262144
# Per-client request budget (token bucket, refills continuously).  0 disables.
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=
# Comma-separated browser origins allowed to call the API.  Empty = no CORS
# headers at all (the desktop client is not a browser and needs none).
CORS_ORIGINS=
# Strict-Transport-Security max-age in seconds; 0 omits the header.
HSTS_MAX_AGE=31536000

# ── Database pool ────────────────────────────────────────────────────────
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_S=10
DB_ACQUIRE_TIMEOUT_S=5
DB_COMMAND_TIMEOUT_S=30

# ── Trial / license behaviour ────────────────────────────────────────────
TRIAL_DURATION_DAYS=7
LICENSE_MAX_DEVICES=5
DEVICE_TTL_DAYS=180

# ── Stripe (not wired yet — leave empty) ─────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_TAX_ENABLED=true

# ── VPN / VM detection (not wired yet) ───────────────────────────────────
VPN_CHECK_PROVIDER=
VPN_CHECK_API_KEY=
