# Python bytecode
__pycache__/
*.pyc
*.pyo

# PyInstaller build artifacts — release binaries are tracked in the
# release-site repo (releases/<channel>/Vispora.exe), not here.
build/
build_*/
build-*/
dist/
dist_*/
dist-*/

# Logs + local scratch
*.log
*.tmp

# Editor / IDE
.vscode/
.idea/

# Local env / secrets — never commit credentials
.env
*.env
