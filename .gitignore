# Python bytecode
__pycache__/
*.pyc
*.pyo

# PyInstaller build artifacts — release binaries are tracked in the
# release-site repo (releases/<channel>/Vispora.exe), not here.
build/
build_*/
build-*/
dist/
dist_*/
dist-*/

# Logs + local scratch
*.log
*.tmp

# Editor / IDE
.vscode/
.idea/

# Local env / secrets — never commit credentials
.env
*.env

# The native helper (Rust): build output.  The DLL is built before a release
# (cargo build --release --manifest-path native/Cargo.toml) and bundled by build.spec.
native/target/

# The Rust updater (updater_rs/): build output of its two crates.
updater_rs/core/target/
updater_rs/app/target/
# (Tauri writes the list of its permissions here at every build; the updater grants none)
updater_rs/app/gen/
